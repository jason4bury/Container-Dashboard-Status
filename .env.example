# Container Dashboard Status settings. Copy this file to .env next to docker-compose.yml and fill
# in the values. .env holds a real password: it is gitignored, so never commit it.
# The machines and the SSH key are added in Settings on the page, not here.

# Sign-in (required). The app will not start until these are changed from the examples.
APP_USERNAME=your-username
APP_PASSWORD=change-me

# Long random string used to sign the sign-in cookie and encrypt the saved SSH key (at least 32
# characters). If you change it later, add the SSH key again in Settings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# How often the page checks again, in seconds (at least 10).
REFRESH_SECONDS=30

# Optional: the machines to show at first, until any are added in Settings. Comma-separated,
# each Name=address, such as
#   HOSTS=This PC=unix:///var/run/docker.sock, NAS=ssh://admin@192.168.1.20:22/usr/local/bin/docker
HOSTS=This PC=unix:///var/run/docker.sock

# Optional: only trust machines whose SSH host key has one of these fingerprints (comma-separated),
# as shown by   ssh-keyscan -p 22 192.168.1.20 | ssh-keygen -lf -
# Blank accepts whatever host key the machine shows.
SSH_FINGERPRINTS=

# --- Running without Docker (npm start) ---
# Settings are kept in ./data unless DATA_DIR is set. Use npipe:////./pipe/docker_engine for Docker
# Desktop on Windows, and PORT if you want a port other than 3040.
